---
import { ExternalLink, FilePenLine, Presentation } from "@lucide/astro";
import Layout from "../components/Layout.astro";

const precalculusSchedule = [
  {
    week: "6/21 - 6/27",
    instructors: "Steven X + Jane L",
    topic: "Functions Review + Intro to Trig",
    chapters: "1–2",
    slides: {
      "Session 1 slides":
        "/resources/slides/2025-26/functions-review-session-1",
      "Session 2 slides":
        "/resources/slides/2025-26/functions-review-session-2",
    },
  },
  {
    week: "6/28 - 7/4",
    instructors: "Samuel L + Vincent H",
    topic: "Trig Identities + Applications to Geo",
    chapters: "3–4",
    slides: {
      Slides: "/resources/slides/2025-26/week-2",
    },
  },
  {
    week: "7/5 - 7/11",
    instructors: "Alex Z + Justin K + Kennan S",
    topic:
      "Quick review of Application to Geo + Parameterization and Trigonometric Coordinate System",
    chapters: "5",
    slides: {
      Slides: "/resources/slides/2025-26/week-3",
    },
  },
  {
    week: "7/12 - 7/18",
    instructors: "Catherine J + Derek H",
    topic: "Basics of Complex numbers + Trig and Complex",
    chapters: "6–7",
    slides: {
      Slides: "/resources/slides/2025-26/week-4",
    },
  },
  {
    week: "7/19 - 7/25",
    instructors: "Franklin Z + Eric Z + Jonathan Y",
    topic: "Quick review of Trig and Complex + Vectors in 2 dimensions",
    chapters: "9",
    slides: {
      Slides: "/resources/slides/2025-26/week-5",
    },
  },
  {
    week: "7/26 - 8/1",
    instructors: "Andy L + Yichen W",
    topic: "Matrices in 2 dimensions",
    chapters: "10",
    slides: {
      Slides: "/resources/slides/2025-26/week-6",
    },
  },
];
---

<Layout>
  <div class="bg-gray-50 px-6 py-12 text-center">
    <h1 class="text-4xl font-bold text-text">Schedule</h1>
  </div>
  <section
    aria-labelledby="precalculus-heading"
    class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 mb-64"
  >
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4 pb-4 border-b border-gray-300">
      <h2
        id="precalculus-heading"
        class="text-3xl font-bold text-text sm:text-4xl"
      >
        2026 Summer
      </h2>
      <p class="rounded-full text-xl font-bold">June 21 – August 1</p>
    </div>

    <div class="relative mb-6 overflow-hidden rounded border border-gray-200 bg-white hover:bg-green-50/40 py-4">
      <a
        href="/resources/problem/2025-26/team-1/1"
        class="absolute inset-0"
        aria-label="2025-26 Practice Problems"
      ></a>
      <div class="pl-6 flex place-items-center gap-4">
        <span class="flex h-8 w-17 flex-none items-center justify-center rounded-full border-2 border-gray-600 text-sm font-bold text-gray-700">
          <FilePenLine />
        </span>
        <h3 class="text-xl font-semibold leading-relaxed text-text">
          2025-26 Practice Problems
        </h3>
      </div>

      <a
        href="/resources/problem/2025-26/team-1/1"
        class="relative z-10 ml-27 mt-1 border border-slate-400 rounded pl-2 py-0.5 text-xs text-slate-500 inline-flex place-items-center hover:bg-gray-200"
      >
        View problems
        <ExternalLink class="h-3.5" />
      </a>
    </div>

    <div class="overflow-hidden rounded border border-gray-200 bg-white divide-y divide-gray-200">
      {precalculusSchedule.map((session, index) => (
        <div class="relative p-4 transition-colors hover:bg-green-50/40 sm:px-6 cursor-pointer">
          <a
            href={Object.values(session.slides)[0]}
            class="absolute inset-0"
            aria-label={session.topic}
          ></a>
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-5">
              <span class="flex h-8 w-17 flex-none items-center justify-center rounded-full border-2 border-green-600 text-sm font-bold text-green-700">
                Wk. {index + 1}
              </span>
              <h3 class="text-lg font-semibold leading-relaxed text-text">
                {session.topic}
              </h3>
            </div>

            <div class="flex flex-col place-items-start md:flex-row md:place-items-center gap-4 text-xs pl-22">
              <p class="font-bold text-text">{session.week}</p>
              <p class="text-sm leading-relaxed text-gray-600">
                {session.instructors}
              </p>
              <span class="inline-flex rounded-lg bg-blue-50 px-2 py-1 font-semibold text-blue-800">
                Ch. {session.chapters}
              </span>
              {Object.entries(session.slides).map(([key, value]) => (
                <a
                  href={value}
                  class="relative z-10 border border-slate-400 rounded pl-2 py-0.5 text-xs text-slate-500 inline-flex place-items-center hover:bg-gray-200"
                >
                  {key}
                  <ExternalLink class="h-3.5" />
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
