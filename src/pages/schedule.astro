---
import Layout from "../components/Layout.astro";
---

<Layout>
    <div class="bg-gray-50 py-8">
        <h1 class="text-4xl font-bold text-center mb-6">Schedule</h1>
    </div>
    <div class="max-w-2xl mx-auto pt-8 space-y-3 text-xl">
        <h3 class="text-3xl border-b border-gray-300">Winter 2026</h3>
        <div class="hover:bg-gray-100 cursor-pointer">12/15 to 12/20</div>
    </div>
    <div class="max-w-2xl mx-auto pt-8">
        <h3 class="text-3xl border-b border-gray-300">Spring break 2026</h3>
    </div>
</Layout>
