---
import Layout from "../components/Layout.astro";

const precalculusSchedule = [
    {
        week: "6/21 - 6/27",
        instructors: "Steven X + Jane L",
        topic: "Functions Review + Intro to Trig",
        chapters: "1–2",
    },
    {
        week: "6/28 - 7/4",
        instructors: "Samuel L + Vincent H",
        topic: "Trig Identities + Applications to Geo",
        chapters: "3–4",
    },
    {
        week: "7/5 - 7/11",
        instructors: "Alex Z + Justin K + Kennan S",
        topic: "Quick review of Application to Geo + Parameterization and Trigonometric Coordinate System",
        chapters: "5",
    },
    {
        week: "7/12 - 7/18",
        instructors: "Catherine J + Derek H",
        topic: "Basics of Complex numbers + Trig and Complex",
        chapters: "6–7",
    },
    {
        week: "7/19 - 7/25",
        instructors: "Franklin Z + Eric Z + Jonathan Y",
        topic: "Quick review of Trig and Complex + Vectors in 2 dimensions",
        chapters: "9",
    },
    {
        week: "7/26 - 8/1",
        instructors: "Andy L + Yichen W",
        topic: "Matrices in 2 dimensions",
        chapters: "10",
    },
];
---

<Layout>
    <div class="bg-gray-50 px-6 py-12 text-center">
        <h1 class="text-4xl font-bold text-text">Schedule</h1>
    </div>
    <section
        aria-labelledby="precalculus-heading"
        class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14"
    >
        <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
            <h2
                id="precalculus-heading"
                class="text-3xl font-bold text-text sm:text-4xl"
            >
                2026 Summer
            </h2>
            <p class="rounded-full text-xl font-bold">June 21 – August 1</p>
        </div>

        <div class="overflow-hidden rounded border border-gray-200 bg-white shadow-sm">
            <div
                aria-hidden="true"
                class="hidden grid-cols-[1fr_1.5fr_2.4fr_0.7fr] gap-6 bg-gray-50 px-6 py-4 text-xs font-bold uppercase tracking-wider text-gray-500 lg:grid"
            >
                <span>Week</span>
                <span>Instructors</span>
                <span>Topics</span>
                <span>Chapters</span>
            </div>
            <ol class="divide-y divide-gray-200">
                {precalculusSchedule.map((session, index) => (
                    <li class="grid gap-4 p-5 transition-colors hover:bg-green-50/40 sm:p-6 lg:grid-cols-[1fr_1.5fr_2.4fr_0.7fr] lg:items-center lg:gap-6">
                        <div class="flex items-center gap-3 lg:block">
                            <span class="font-bold uppercase tracking-wider text-green-700 mr-4">
                                {index + 1}
                            </span>
                            <span class="font-bold text-text lg:mt-1">
                                {session.week}
                            </span>
                        </div>
                        <div class="order-3 lg:order-none">
                            <p class="mb-1 text-xs font-bold uppercase tracking-wider text-gray-500 lg:hidden">
                                Instructors
                            </p>
                            <p class="text-sm leading-relaxed text-gray-600">
                                {session.instructors}
                            </p>
                        </div>
                        <div>
                            <p class="mb-1 text-xs font-bold uppercase tracking-wider text-gray-500 lg:hidden">
                                Topics
                            </p>
                            <h3 class="text-base font-semibold leading-relaxed text-text">
                                {session.topic}
                            </h3>
                        </div>
                        <div class="order-4 lg:order-none">
                            <span class="inline-flex rounded-lg bg-blue-50 px-3 py-1.5 text-sm font-semibold text-blue-800">
                                <span class="sr-only">AOPS Precalc Book, </span>
                                Ch. {session.chapters}
                            </span>
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </section>
</Layout>
