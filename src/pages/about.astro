---
import Layout from "../components/Layout.astro";
import Img from "../components/Img.astro";
import { teamMembers } from "../data/team-biographies";
---

<Layout>
    <div class="*:odd:bg-gray-50">
        <div class="flex place-items-center justify-center bg-green-950! px-6 py-32 sm:py-44 lg:py-56">
            <div class="flex max-w-5xl flex-col gap-8 place-items-center justify-center *:text-center">
                <h1 class="text-5xl leading-tight font-cursive text-white font-extrabold sm:text-7xl lg:text-8xl">
                    Pal4Pal Education Outreach
                </h1>
                <p class="max-w-3xl text-lg leading-relaxed text-green-100/85 sm:text-2xl">
                    We're a nonprofit organization that brings STEM education to
                    students. We believe that a solid education starts with
                    solid foundations in Math and Science.
                </p>
            </div>
        </div>
        <div class="px-6 py-20 sm:py-28 flex flex-col justify-center place-items-center gap-8 sm:gap-12">
            <h2 class="text-4xl sm:text-5xl text-center text-green-950">How we started</h2>
            <p class="text-lg sm:text-2xl leading-relaxed text-gray-600 max-w-4xl">
                We're a nonprofit organization that brings{" "}
                <span class="text-primary font-bold">
                    STEM education to students
                </span>
                . We believe that a solid education starts with solid
                foundations in Math and Science.
                <br />
                <br />
                We are{" "}
                <span class="text-primary font-bold">
                    student volunteers
                </span>{" "}
                that specialize in math and we are passionate about giving back
                to the community.
            </p>
        </div>
        <div class="px-4 py-20 sm:px-6 sm:py-28 flex flex-col justify-center place-items-center gap-8 sm:gap-12">
            <h2 id="our-team" class="text-4xl sm:text-5xl text-center text-green-950">Meet our team</h2>
            <section class="w-full max-w-7xl" aria-labelledby="our-team">
                <div class="*:odd:bg-white *:even:bg-green-50 *:rounded-2xl mt-4 space-y-16 sm:space-y-24">
                    {teamMembers.map((member, index) => (
                        <article
                            class="border border-green-950/8 px-6 py-10 shadow-sm sm:px-8 sm:py-16"
                            aria-labelledby={`team-member-${index}`}
                        >
                            <div class="mx-auto grid w-full max-w-7xl items-center gap-8 md:grid-cols-2 md:gap-12 lg:px-16">
                                <Img
                                    src={member.image}
                                    class:list={[
                                        "w-full max-w-sm justify-self-center rounded-xl shadow-sm",
                                        index % 2 === 0
                                            ? "md:justify-self-start"
                                            : "md:order-2 md:justify-self-end",
                                    ]}
                                />
                                <div class="min-w-0 space-y-6">
                                    <div class="space-y-2">
                                        <h3
                                            id={`team-member-${index}`}
                                            class="text-2xl sm:text-3xl leading-tight font-bold text-slate-900"
                                        >
                                            {member.title}
                                        </h3>
                                        <p class="text-xl text-gray-500">
                                            {member.gradeLevel}
                                        </p>
                                    </div>
                                    <div class="space-y-4 text-lg leading-relaxed text-gray-600">
                                        {member.biography.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        </div>
    </div>
</Layout>
