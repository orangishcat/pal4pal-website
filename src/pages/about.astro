---
import Layout from "../components/Layout.astro";
import Img from "../components/Img.astro";
import placeholder from "../assets/placeholder.jpg";
import { teamMembers } from "../data/team-biographies";
---

<Layout>
    <div class="*:odd:bg-gray-50">
        <div class="flex place-items-center justify-center py-70 bg-green-950!">
            <div class="flex flex-col gap-6 place-items-center justify-center *:text-center">
                <h1 class="text-8xl font-cursive text-white font-extrabold">
                    Pal4Pal Education Outreach
                </h1>
                <p class="text-2xl text-gray-300 max-w-4xl">
                    We're a nonprofit organization that brings STEM education to
                    students. We believe that a solid education starts with
                    solid foundations in Math and Science.
                </p>
            </div>
        </div>
        <div class="py-32 flex flex-col justify-center place-items-center gap-12">
            <h1 class="text-5xl text-center">How we started</h1>
            <p class="text-2xl text-gray-600 max-w-4xl">
                We're a nonprofit organization that brings{" "}
                <span class="text-primary font-bold">
                    STEM education to students
                </span>
                . We believe that a solid education starts with solid
                foundations in Math and Science.
                <br />
                <br />
                We are{" "}
                <span class="text-primary font-bold">
                    student volunteers
                </span>{" "}
                that specialize in math and we are passionate about giving back
                to the community.
            </p>
        </div>
        <div class="py-32 flex flex-col justify-center place-items-center gap-12">
            <h1 class="text-5xl text-center">Meet our team</h1>
            <section>
                <div class="*:odd:bg-white *:even:bg-green-50 *:rounded-xl mt-8 space-y-48">
                    {teamMembers.map((member, index) => (
                        <article
                            class="px-8 py-16 shadow-xl"
                            aria-labelledby={`team-member-${index}`}
                        >
                            <div class="mx-auto grid w-full max-w-7xl items-center gap-8 md:grid-cols-2 md:gap-12 lg:px-16">
                                <Img
                                    src={member.image}
                                    class:list={[
                                        "w-full max-w-sm justify-self-center rounded-xl",
                                        index % 2 === 0
                                            ? "md:justify-self-start"
                                            : "md:order-2 md:justify-self-end",
                                    ]}
                                />
                                <div class="min-w-0 space-y-6">
                                    <div class="space-y-2">
                                        <h3
                                            id={`team-member-${index}`}
                                            class="text-3xl font-bold text-slate-900"
                                        >
                                            {member.title}
                                        </h3>
                                        <p class="text-xl text-gray-500">
                                            {member.gradeLevel}
                                        </p>
                                    </div>
                                    <div class="space-y-4 text-lg leading-relaxed text-gray-600">
                                        {member.biography.map((paragraph) => (
                                            <p>{paragraph}</p>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        </div>
    </div>
</Layout>
