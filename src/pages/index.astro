---
import Layout from "../components/Layout.astro";
import Button from "../components/Button.astro";
import Img from "../components/Img.astro";
import placeholder from "../assets/placeholder.jpg";
import homepage from "../assets/hero.avif";
import aime from "../assets/aime.avif";
import ImageCarousel from "../components/ImageCarousel.astro";

import { volunteerSlides } from "../data/team";
import { withBase } from "../utils/url";
---

<Layout>
  <div
    class="*:flex *:justify-center *:place-items-center *:h-150 *:px-8 *:odd:bg-gray-50
    [&>div>div.grid]:grid [&>div>div.grid]:grid-cols-2 [&>div>div.grid]:px-16 [&>div>div.grid]:w-full [&>div>div.grid]:max-w-7xl
    [&>div>div.grid]:gap-12 [&>div>div.grid]:items-center
    [&>div>div.grid>*:nth-child(odd)]:justify-self-start [&>div>div.grid>*:nth-child(even)]:justify-self-end"
  >
    <div class="bg-slate-800! h-180!">
      <div class="grid">
        <div class="my-auto space-y-6">
          <h1 class="text-7xl text-white font-bold">Empowering the Youth</h1>
          <p class="text-2xl text-gray-400 max-w-2xl">
            Educational math workshops to build solid STEM foundations in
            middle-to-high schoolers.
          </p>
        </div>
        <div class="max-w-lg">
          <Img src={homepage} />
        </div>
      </div>
    </div>
    <div class="h-auto! min-h-185">
      <div class="w-full max-w-5xl py-16">
        <div class="flex flex-col place-items-center justify-center gap-4 p-6">
          <h2 class="text-4xl text-slate-900 font-bold text-center">
            Driven by student volunteers
          </h2>
          <ImageCarousel slides={volunteerSlides} label="Student volunteers" />
          <div class="flex gap-4">
            <Button theme="primary" href={withBase("/about")}>
              About us
            </Button>
            <Button theme="ghost" href={withBase("/volunteering")}>
              Volunteering opportunities
            </Button>
          </div>
        </div>
      </div>
    </div>
    <div>
      <div class="grid">
        <div class="flex flex-col gap-4 p-6">
          <h2 class="text-4xl font-bold">
            AMC and AIME-level practice problems
          </h2>
          <p class="text-xl text-gray-500 max-w-2xl">
            Free, online problems spanning various difficulties with detailed
            step-by-step explanations.
          </p>
          <Button theme="primary" href={withBase("/resources")}>
            View problems
          </Button>
        </div>
        <div>
          <Img src={aime} />
        </div>
      </div>
    </div>
    <div class="h-100! flex flex-col place-items-center">
      <div class="my-auto space-y-8 max-w-xl *:text-center">
        <h1 class="text-5xl font-semibold">
          Building strong STEM foundations in students
        </h1>
        <div class="flex justify-center gap-4 mt-1 text-xl">
          <Button theme="primary" href={withBase("/signup")}>
            Sign up
          </Button>
          <Button
            theme="ghost"
            href={withBase("/schedule")}
            class="bg-transparent!"
          >
            View schedule
          </Button>
        </div>
      </div>
    </div>
  </div>
</Layout>
