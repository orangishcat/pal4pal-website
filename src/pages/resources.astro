---
import { ChevronRight } from "@lucide/astro";
import Layout from "../components/Layout.astro";
import ProblemSidebar from "../components/ProblemSidebar.astro";
import { getCollection } from "astro:content";
import { problemNav } from "../utils/problem-nav";
import { problemHref } from "../utils/problem-slugs";
import { withBase } from "../utils/url";
const resourceUrl = (filename: string) =>
  withBase(`/resources/problems/${encodeURIComponent(filename)}`);

const docs = (await getCollection("problems")).sort((a, b) => {
  const teamOrder = (id: string) => Number(id.match(/team-(\d+)/)?.[1] ?? 0);
  const n = (id: string) => Number(id.match(/\/(\d+)$/)?.[1] ?? 0);
  return teamOrder(a.id) - teamOrder(b.id) || n(a.id) - n(b.id);
});
const totalCount = docs.length;
const sets = [
  ...new Map(docs.map((doc) => [doc.data.team, docs.filter((d) => d.data.team === doc.data.team)])).entries(),
];
---

<Layout>
  <div class="mx-auto flex min-h-screen max-w-6xl flex-col gap-10 px-5 py-12 sm:px-8 sm:py-16 lg:flex-row">
    <aside class="w-full shrink-0 lg:w-64">
      <div class="lg:sticky lg:top-8">
        <ProblemSidebar isIndex />
      </div>
    </aside>
    <section
      id="practice-list"
      aria-labelledby="problems-heading"
      class="min-w-0 flex-1"
    >
      <header class="mb-12 max-w-2xl">
        <h1
          id="problems-heading"
          class="text-4xl font-bold tracking-tight text-text sm:text-5xl"
        >
          Resources
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-gray-600">
          View past practice problems from different years of Pal4Pal.
        </p>
      </header>
      <div>
        <section aria-labelledby="year-2026" class="mb-16">
          <header class="flex items-baseline justify-between gap-4 border-b border-green-800/20 pb-4">
            <h2 id="year-2026" class="scroll-mt-8 text-3xl font-bold text-text">
              2025–26
            </h2>
            <span class="text-sm text-gray-500">{totalCount} problems</span>
          </header>
          {sets.map(([team, teamDocs], setIndex) => {
            const nav = problemNav.find((entry) => entry.team === team)!;
            return (
              <details
                aria-labelledby={`team-${setIndex}`}
                class="group/set mt-6"
              >
                <summary class="flex cursor-pointer list-none items-center gap-3 [&::-webkit-details-marker]:hidden">
                  <div class="text-gray-400">
                    <ChevronRight class="transition-transform group-open/set:rotate-90" />
                  </div>
                  <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-3">
                    <div>
                      <h3
                        id={`team-${setIndex}`}
                        class="text-xl font-bold text-text"
                      >
                        {team} Problem Set
                      </h3>
                      <p class="mt-2 text-sm text-gray-600">By {nav.authors}</p>
                    </div>
                    <span class="text-sm text-gray-500">
                      {teamDocs.length} problems
                    </span>
                  </div>
                </summary>
                <div class="set-downloads mt-5 flex flex-wrap gap-4 text-sm text-green-800 pl-8">
                  <a href={resourceUrl(nav.problemsPdf)}>Problems PDF ↗</a>
                  <a href={resourceUrl(nav.solutionsPdf)}>Solutions PDF ↗</a>
                  {nav.document && (
                    <a href={resourceUrl(nav.document)} download>
                      Editable DOCX
                    </a>
                  )}
                </div>
                <ol class="divide-y divide-gray-200 pl-8">
                  {teamDocs.map((doc, index) => (
                    <li class="py-4">
                      <a
                        href={problemHref(team, index)}
                        class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-green-800 hover:underline"
                      >
                        <span class="font-semibold">Problem {index + 1}</span>
                        <span>{doc.data.topic}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            );
          })}
        </section>
      </div>
    </section>
  </div>
</Layout>
