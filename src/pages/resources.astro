---
import Layout from "../components/Layout.astro";
import ProblemSidebar from "../components/ProblemSidebar.astro";
import { withBase } from "../utils/url";
import fs from "node:fs";
import path from "node:path";
import {
  slideLessonHref,
  slideLessons,
  slideLessonBySlug,
} from "../utils/slide-lessons";

if (
  slideLessons.length !==
  fs
    .readdirSync(path.resolve("public/resources/slides"), {
      recursive: true,
    })
    .filter((f) => f.endsWith(".pdf")).length
) {
  throw new Error(
    "Slides in public/resources/slides don't match slideLessons in src/utils/slide-lessons.ts. Update the list there and rebuild.",
  );
}

const slides = slideLessons.map((lesson) => ({
  name: lesson.title,
  href: slideLessonHref(lesson.slug),
}));
---

<Layout>
  <div class="border-t border-gray-300">
    <div class="mx-auto flex min-h-screen max-w-7xl flex-col gap-10 px-5 sm:px-8 lg:flex-row">
      <aside class="w-full shrink-0 lg:w-64 border-r border-gray-300 p-4 pt-16">
        <ProblemSidebar />
      </aside>

      <section class="min-w-0 flex-1 px-4 py-16">
        <div class="border-b border-gray-300 space-y-4 h-1/2">
          <h1 class="text-4xl font-bold border-b border-gray-300 pb-4">
            Resources
          </h1>
          <p>View past problems created by the Pal4Pal team.</p>
        </div>

        <div class="text-right mt-4">
          <a
            href={withBase("/resources/problem/team-1/1")}
            class="text-green-800 hover:underline"
          >
            View problems →
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
