---
import ResourcesLayout from "../components/ResourcesLayout.astro";
import { withBase } from "../utils/url";
import { slideLessons } from "../utils/slide-lessons";
import fs from "node:fs";
import path from "node:path";

if (
  slideLessons.length !==
  fs
    .readdirSync(path.resolve("public/resources/slides"), {
      recursive: true,
    })
    .filter((f) => f.endsWith(".pdf")).length
) {
  throw new Error(
    "Slides in public/resources/slides don't match slideLessons in src/utils/slide-lessons.ts. Update the list there and rebuild.",
  );
}
---

<ResourcesLayout>
  <div class="border-b border-gray-300 space-y-4 min-h-[50vh]">
    <h1 class="text-4xl font-bold border-b border-gray-300 pb-4">Resources</h1>
    <p>View past problems created by the Pal4Pal team.</p>
  </div>

  <div class="text-right mt-4">
    <a
      href={withBase("/resources/problem/team-1/1")}
      class="text-green-800 hover:underline"
    >
      View problems →
    </a>
  </div>
</ResourcesLayout>
