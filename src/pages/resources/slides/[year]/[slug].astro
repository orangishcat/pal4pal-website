---
import Layout from "../../../../components/Layout.astro";
import ProblemSidebar from "../../../../components/ProblemSidebar.astro";
import {
  slideLessonHref,
  slideLessonPdfHref,
  slideLessons,
} from "../../../../utils/slide-lessons";

export function getStaticPaths() {
  return slideLessons.map((lesson, index) => ({
    params: { year: lesson.year, slug: lesson.slug },
    props: {
      lesson,
      prev: index > 0 ? slideLessons[index - 1] : undefined,
      next:
        index < slideLessons.length - 1 ? slideLessons[index + 1] : undefined,
    },
  }));
}

const { lesson, prev, next } = Astro.props;
const pdfHref = slideLessonPdfHref(lesson);
---

<Layout>
  <div class="border-t border-gray-300">
    <div class="mx-auto flex min-h-screen flex-col max-w-7xl gap-10 pl-8 pr-16 lg:flex-row">
      <ProblemSidebar currentLessonSlug={lesson.slug} />

      <section
        aria-labelledby="slide-heading"
        class="min-w-0 flex-1 py-16 pl-4"
      >
        <header class="mb-8 border-b border-green-800/20 pb-6">
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1
              id="slide-heading"
              class="text-3xl font-bold tracking-tight text-text sm:text-4xl"
            >
              {lesson.title}
            </h1>
          </div>
        </header>

        <iframe
          src={pdfHref}
          title={lesson.title}
          class="h-[75vh] w-full rounded-lg border border-gray-200"
        >
        </iframe>
        <nav
          aria-label="Slide pagination"
          class="mt-12 flex flex-wrap items-end justify-between gap-4 border-t border-gray-200 pt-6 text-sm"
        >
          <div>
            {prev && (
              <a
                href={slideLessonHref(prev.slug)}
                class="text-green-800 hover:underline"
              >
                ← {prev.title}
              </a>
            )}
          </div>

          <a
            href={pdfHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-green-800 hover:underline"
          >
            Download
          </a>
          <div class="text-right">
            {next && (
              <a
                href={slideLessonHref(next.slug)}
                class="text-green-800 hover:underline"
              >
                {next.title} →
              </a>
            )}
          </div>
        </nav>
      </section>
    </div>
  </div>
</Layout>
