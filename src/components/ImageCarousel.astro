---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    slides: {
        image: ImageMetadata;
        alt: string;
        title: string;
        subtitle?: string;
        description: string;
    }[];
    label?: string;
}

const { slides, label = "Image carousel" } = Astro.props;
---

<image-carousel class="block w-full max-w-4xl py-8" role="region" aria-roledescription="carousel" aria-label={label}>
    <div data-viewport class="relative overflow-hidden" aria-live="polite" aria-atomic="true">
        {slides.map((slide, index) => (
            <div data-slide class:list={["duration-700 ease-in-out motion-reduce:transition-none", { hidden: index !== 0 }]} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}`}>
                <div class="grid items-center gap-6 md:grid-cols-2 md:gap-16">
                    <Image src={slide.image} alt={slide.alt} format="avif" class="aspect-square w-full max-w-sm justify-self-center rounded-2xl object-cover" />
                    <div class="space-y-4 text-center md:text-left">
                        <h3 class="text-3xl font-semibold text-slate-900 md:text-4xl">{slide.title}</h3>
                        {slide.subtitle && <p class="text-lg font-medium text-slate-600">{slide.subtitle}</p>}
                        <p class="text-lg leading-relaxed text-gray-500">{slide.description}</p>
                    </div>
                </div>
            </div>
        ))}
    </div>
    <div data-controls hidden class="mt-8">
        <div class="flex items-center justify-center gap-4">
            <button type="button" data-previous aria-label="Previous slide" class="rounded-full border border-slate-300 px-4 py-2 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-4">←</button>
            <div class="flex gap-3">
                {slides.map((_, index) => (
                    <button type="button" data-dot aria-label={`Go to slide ${index + 1}`} aria-current={index === 0 ? "true" : "false"} class="h-4 w-4 rounded-full bg-slate-300 aria-[current=true]:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-4" />
                ))}
            </div>
            <button type="button" data-next aria-label="Next slide" class="rounded-full border border-slate-300 px-4 py-2 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-4">→</button>
        </div>
    </div>
</image-carousel>

<script>
    import { Carousel } from "flowbite";

    class ImageCarousel extends HTMLElement {
        private resizeObserver?: ResizeObserver;
        private carousel?: Carousel;

        connectedCallback() {
            if (this.dataset.initialized) return;
            this.dataset.initialized = "true";
            const slides = Array.from(this.querySelectorAll<HTMLElement>("[data-slide]"));
            const dots = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-dot]"));
            if (!slides.length) return;
            const viewport = this.querySelector<HTMLElement>("[data-viewport]")!;
            const resize = () => {
                viewport.style.height = `${Math.max(...slides.map(slide => slide.firstElementChild!.getBoundingClientRect().height))}px`;
            };
            resize();
            const carousel = new Carousel(this, slides.map((el, position) => ({ el, position })), {
                defaultPosition: 0,
                indicators: {
                    activeClasses: "bg-slate-700",
                    inactiveClasses: "bg-slate-300",
                    items: dots.map((el, position) => ({ el, position })),
                },
                onChange: (instance) => {
                    slides.forEach((slide, index) => {
                        slide.setAttribute("aria-hidden", String(index !== instance.getActiveItem().position));
                    });
                    resize();
                },
            }, { id: crypto.randomUUID() });
            this.carousel = carousel;
            this.resizeObserver = new ResizeObserver(resize);
            slides.forEach(slide => this.resizeObserver!.observe(slide.firstElementChild!));
            this.querySelector<HTMLElement>("[data-controls]")!.hidden = slides.length < 2;
            this.querySelector("[data-previous]")?.addEventListener("click", () => carousel.prev());
            this.querySelector("[data-next]")?.addEventListener("click", () => carousel.next());
            this.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
                event.preventDefault();
                if (event.key === "ArrowRight") carousel.next();
                else carousel.prev();
            });
        }

        disconnectedCallback() {
            this.resizeObserver?.disconnect();
            this.carousel?.destroyAndRemoveInstance();
        }
    }
    if (!customElements.get("image-carousel")) {
        customElements.define("image-carousel", ImageCarousel);
    }
</script>
