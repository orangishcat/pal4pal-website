---
const { entry } = Astro.locals.starlightRoute;
const data = entry.data;

const isProblem = typeof data.team === "string";
---

<h1 id="_top">{data.title}</h1>

{
  isProblem && (
    <div class="problem-meta">
      <span>Problem credits: {data.author}</span>
      <span>Skill: {data.topic}</span>
    </div>
  )
}
