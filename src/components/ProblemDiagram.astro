---
interface Props { kind: "semicircle" | "triangle"; }
const { kind } = Astro.props;
---
<figure class="my-6 max-w-lg">
    {kind === "semicircle" ? <svg viewBox="0 0 400 230" role="img" aria-label="Semicircle with diameter AB, points C and D on the arc, and E at the intersection of AD and BC.">
        <g fill="none" stroke="#64748b" stroke-width="2">
            <path d="M40 200 A160 160 0 0 1 360 200 Z" />
            <path d="M40 200 L242 46 L360 200 L330 107 L40 200" />
        </g>
        <g fill="#166534"><circle cx="40" cy="200" r="4"/><circle cx="360" cy="200" r="4"/><circle cx="242" cy="46" r="4"/><circle cx="330" cy="107" r="4"/><circle cx="297" cy="117.6" r="4"/></g>
        <g fill="#334155" font-size="18"><text x="20" y="198">A</text><text x="369" y="202">B</text><text x="246" y="35">C</text><text x="338" y="102">D</text><text x="279" y="142">E</text></g>
    </svg> : <svg viewBox="0 0 600 220" role="img" aria-label="Right triangle ABC, with P on BC and Q on AC, CP equals CQ equals 2. AP and BQ meet at R, CR meets AB at S, and PQ meets the extension of AB at T.">
        <g fill="none" stroke="#64748b" stroke-width="2">
            <path d="M240 30 L560 30 L330 190 Z M20 30 L240 30 M20 30 L413 132 M560 30 L300 137 M240 30 L413 132 M330 190 L330 30" />
        </g>
        <g fill="#166534"><circle cx="20" cy="30" r="4"/><circle cx="240" cy="30" r="4"/><circle cx="560" cy="30" r="4"/><circle cx="330" cy="190" r="4"/><circle cx="330" cy="30" r="4"/><circle cx="330" cy="125" r="4"/><circle cx="300" cy="137" r="4"/><circle cx="413" cy="132" r="4"/></g>
        <g fill="#334155" font-size="18"><text x="16" y="18">T</text><text x="237" y="18">B</text><text x="556" y="18">A</text><text x="336" y="204">C</text><text x="334" y="18">S</text><text x="335" y="120">R</text><text x="281" y="135">P</text><text x="421" y="131">Q</text></g>
    </svg>}
    <figcaption class="mt-1 text-xs text-gray-500">Diagram from the problem setup; not to scale.</figcaption>
</figure>
