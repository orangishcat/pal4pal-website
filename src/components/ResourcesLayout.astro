---
import Layout from "./Layout.astro";
import ProblemSidebar from "./ProblemSidebar.astro";

interface Props {
  currentSetSlug?: string;
  currentProblem?: number;
  currentLessonSlug?: string;
  /** Extra Tailwind classes appended to the content section. */
  sectionClass?: string;
}

const {
  currentSetSlug,
  currentProblem,
  currentLessonSlug,
  sectionClass = "",
} = Astro.props;
---

<Layout>
  <div class="border-t border-gray-300">
    <div class="mx-auto flex min-h-screen flex-col gap-10 px-4 py-8 lg:px-0 lg:py-0 lg:flex-row lg:pl-8 lg:pr-16">
      <ProblemSidebar {currentSetSlug} {currentProblem} {currentLessonSlug} />

      <section class={`min-w-0 flex-1 py-16 pl-4 max-w-5xl ${sectionClass}`}>
        <slot />
      </section>
    </div>
  </div>
</Layout>
