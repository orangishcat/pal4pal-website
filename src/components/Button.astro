---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
    theme?: "primary" | "secondary" | "accent" | "ghost" | "destructive";
    href?: string;
}

const themes = {
    primary: "bg-primary text-white font-semibold enabled:hover:bg-primary/80",
    secondary:
        "bg-secondary text-white font-semibold enabled:hover:bg-secondary/80",
    accent: "bg-accent text-white font-semibold enabled:hover:bg-accent/80",
    ghost: "bg-white text-black border border-slate-300 enabled:hover:bg-text/10",
    destructive: "bg-red-700 text-white font-semibold enabled:hover:bg-red-800",
} satisfies Record<NonNullable<Props["theme"]>, string>;

const {
    theme = "primary",
    type = "button",
    href,
    class: className,
    "class:list": classList,
    ...attributes
} = Astro.props;

const Wrapper = href !== undefined ? "a" : Fragment;
---

<!-- outer div wrapper keeps button from being stretched by flexbox,
while allowing the button width to change via directly assigned Tailwind classes -->
<div>
    <Wrapper href={href}>
        <button
            {...attributes}
            type={type}
            data-theme={theme}
            class:list={[
                "inline-flex items-center justify-center gap-2 rounded-lg",
                "px-6 py-2 leading-normal cursor-pointer disabled:opacity-50",
                "transition-colors duration-150 motion-reduce:transition-none focus-visible:outline-2",
                "focus-visible:outline-offset-3 focus-visible:outline-text disabled:cursor-not-allowed",
                themes[theme],
                className,
                classList,
            ]}
        >
            <slot />
        </button>
    </Wrapper>
</div>
